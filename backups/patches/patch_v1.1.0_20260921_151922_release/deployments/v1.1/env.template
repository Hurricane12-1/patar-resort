# ==============================================================================
# J & D Beach House Deployment Environment Template · Version 1.1 Enterprise
# ==============================================================================

# Core Application Settings
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=https://localhost:4000

# Supabase PostgreSQL Core Infrastructure
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-key-32-chars-min

# Redis Caching & Cluster Session Store
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# SMS Gateway Integration (Twilio Cloud)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# TLS / HTTPS Local Certificates
SSL_KEY_PATH=./server/certs/key.pem
SSL_CERT_PATH=./server/certs/cert.pem

# High-Availability Cluster Load Balancer
LOAD_BALANCER_PORT=8080
CLUSTER_WORKERS=2
