# ==============================================================================
# J & D Beach House Resort Management System · Master Environment Template
# Version: 1.1 Enterprise (Tri-API, Redis Cache, TLS 1.3, Load Balancing)
# ==============================================================================

# Core Application Settings
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=https://localhost:4000

# Supabase PostgreSQL Core Infrastructure
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_JWT_SECRET=your-32-character-minimum-jwt-secret-key

# Redis High-Performance Caching & Session Store
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS Gateway Integration (Twilio Cloud)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# TLS / HTTPS Local Certificates
SSL_KEY_PATH=./server/certs/key.pem
SSL_CERT_PATH=./server/certs/cert.pem

# High-Availability Cluster Load Balancer
LOAD_BALANCER_PORT=8080
CLUSTER_WORKERS=2
