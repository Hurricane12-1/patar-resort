  <diagram id="cross-functional" name="Cross-Functional Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1546" pageHeight="1334" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cross-Functional Architecture Map&#xa;Rows are request paths. Columns are architecture layers. patar-resort main @ 0550fc7" style="text;html=0;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1200" height="60" as="geometry"/></mxCell>
        <mxCell id="hdr-label" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr0" value="LAYER 01&#xa;Client" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="196" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr1" value="LAYER 02&#xa;Edge and security" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="412" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr2" value="LAYER 03&#xa;API surfaces" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="628" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr3" value="LAYER 04&#xa;Domain services" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="844" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr4" value="LAYER 05&#xa;Data and cache" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="hdr5" value="LAYER 06&#xa;External services" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontColor=#000000;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="80" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="rl-components" value="Components" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;fontSize=13;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="150" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-0" value="Guest portal: / · /guest · /rooms · /policy&#xa;Admin console: /admin/* · ledger, rooms, accounts&#xa;Staff desks: /staff/operations · /reception · /accounting&#xa;Guest account: /client/bookings · /profile · /help&#xa;Recovery portal: /recovery/*&#xa;Route guards: Admin, Staff, Recovery, Client&#xa;Backup modal: export SQL, JSON, CSV; dry-run import&#xa;Frontend adapters: REST, GraphQL, WebSocket&#xa;Browser Supabase session" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="196" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-1" value="1 pathNormalizer&#xa;2 securityHeaders (Helmet, CSP, HSTS)&#xa;3 apiCacheControl&#xa;4 corsPolicy&#xa;5 globalLimiter&#xa;6 concurrencyLimiter (250 in flight)&#xa;7 cookieTokenizer (CSRF token)&#xa;8 ngwfFirewall (strikes per IP)&#xa;9 express.json (5 MB)&#xa;10 antiXssSanitizer&#xa;authenticate, requireAdmin, requireFinanceOrAdmin&#xa;bruteForceGuard (5 failures, 15 min lock)&#xa;Joi and Zod validation, error handlers" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="412" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-2" value="REST API: /api/*, 22 route modules&#xa;GraphQL: /api/graphql&#xa;Socket.io: chat:message, staff:customer_handoff&#xa;Framework loader: mounts routes and modules at boot&#xa;Ledger endpoints: export, import (dry_run), clear" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="628" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-3" value="Ledger service: double-entry, adaptive import, snapshots&#xa;Ledger ingestion agent: logbook parsing&#xa;Reservations: Supabase-backed&#xa;Price requests: rate-change approvals&#xa;Customer accounts: bcrypt hashes&#xa;Audit logger: 2,000 in memory, audit_logs.json, Supabase&#xa;Authorization rules: mirror Supabase RLS&#xa;Schema collector: introspects tables every 60 s" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-4" value="Supabase PostgreSQL: service-role and per-user RLS clients&#xa;Redis cache (optional): falls back to memory&#xa;ledger_entries.json: written on every commit&#xa;ledger_snapshots/: before import into a non-empty ledger&#xa;audit_logs.json&#xa;Telemetry: in-memory, lost on restart&#xa;Uploads: server/uploads, served at /uploads" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="cell-components-5" value="Supabase Auth (required): sign-in, Google, Facebook OAuth&#xa;Twilio SMS (optional): environment-enabled&#xa;SMTP email (optional): nodemailer&#xa;Cloudinary (optional): image hosting&#xa;Not connected: payment gateway (see UNFINISHED_FEATURES.txt)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1276" y="124" width="210" height="440" as="geometry"/></mxCell>
        <mxCell id="rl-ledgerImport" value="Ledger import (admin)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;fontSize=13;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="150" height="140" as="geometry"/></mxCell>
