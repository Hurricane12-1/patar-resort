    "test:limiter": "node scripts/test_load_balancer_and_limiter.js",
    "proxy:lb": "node scripts/proxy_load_balancer.js",
    "cluster:lb": "node scripts/load_balancer.js",
    "test:mcp:diagram": "node C:/Users/Sheep/.gemini/antigravity/mcp/drawio-diagram/test.js",
    "test:mcp:cmd": "node mcp-server/test.js",
    "test:mcp": "node C:/Users/Sheep/.gemini/antigravity/mcp/drawio-diagram/test.js && node mcp-server/test.js"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
