    "domain:setup": "cmd /c scripts\\setup_local_domain.bat",
    "framework:inspect": "node scripts/inspect_framework.js",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "server:test": "npm run test --prefix server",
    "test:auth": "npm run test:auth --prefix server",
